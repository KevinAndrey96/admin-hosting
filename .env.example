# =============================================================================
# Environment Variables - Admin Panel (Domains / Hosting)
# Copy this file to .env and fill in the values.
# Values with special characters (#, =, spaces, etc.) must be quoted.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# MySQL: mysql://user:password@host:port/database_name
# If the password has special characters (@, #, etc.), use quotes.
DATABASE_URL="mysql://user:password@localhost:3306/admin"

# -----------------------------------------------------------------------------
# Session (required)
# -----------------------------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET="your-session-secret-at-least-32-characters-long"

# -----------------------------------------------------------------------------
# SMTP - Email (required for reminders, password recovery, etc.)
# -----------------------------------------------------------------------------
SMTP_HOST=mail.tudominio.com
SMTP_PORT=587
SMTP_USER=info@tudominio.com
# If the password has special characters, use quotes: SMTP_PASSWORD="pass@word#123"
SMTP_PASSWORD=tu_password
# true for port 465 (SSL), false for 587 (TLS)
SMTP_SECURE=false
# Optional: different sender than SMTP_USER
# SMTP_FROM=noreply@tudominio.com

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Base public URL (for links in emails: reset-password, reminders, etc.)
# In production: https://tudominio.com (no trailing slash)
APP_URL="https://tudominio.com"
# Alternative: NEXT_PUBLIC_APP_URL (used if APP_URL is not defined)
# NEXT_PUBLIC_APP_URL="https://tudominio.com"
# Base path if the app is under a subpath (e.g. /admin). Defined in next.config.js if fixed.
# NEXT_PUBLIC_BASE_PATH=/admin

# -----------------------------------------------------------------------------
# Cron - Automatic reminders
# -----------------------------------------------------------------------------
# Secret to authorize the /api/cron/renewal-reminders endpoint
# Generate with: openssl rand -base64 32
# If defined, the cron requires: Authorization: Bearer CRON_SECRET
CRON_SECRET="your-cron-secret-generate-with-openssl-rand-base64-32"

# -----------------------------------------------------------------------------
# Email (development)
# -----------------------------------------------------------------------------
# true = do not send real emails, only log to console
# EMAIL_SKIP_SEND=false

# -----------------------------------------------------------------------------
# WHM API - cPanel suspend/unsuspend (optional)
# -----------------------------------------------------------------------------
# Create API token in WHM: Home > Development > Manage API Tokens
# WHM_HOST=instanceshape.com
# WHM_PORT=2087
# WHM_USER=root
# WHM_API_TOKEN=your_whm_api_token

# -----------------------------------------------------------------------------
# Spaceship - Domain availability check (optional)
# -----------------------------------------------------------------------------
# Credentials at https://spaceship.dev/
# SPACESHIP_API_KEY=tu_api_key
# SPACESHIP_API_SECRET=tu_api_secret

# -----------------------------------------------------------------------------
# Google Maps (optional)
# -----------------------------------------------------------------------------
# For the maps page
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu_api_key

# -----------------------------------------------------------------------------
# Server (optional)
# -----------------------------------------------------------------------------
# Default port
# PORT=3000
