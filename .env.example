# Database - Prisma (MySQL)
# Format: mysql://user:password@host:port/database_name
DATABASE_URL="mysql://user:password@localhost:3306/admin"
# If server doesn't support SSL, add: ?sslmode=disable

# Session secret (min 32 chars) - use: openssl rand -base64 32
SESSION_SECRET="your-session-secret-at-least-32-characters-long"

# SMTP - Mail server propio (requerido para recuperación de contraseña, etc.)
SMTP_HOST=mail.tudominio.com
SMTP_PORT=587
SMTP_USER=info@tudominio.com
SMTP_PASSWORD=tu_password
SMTP_SECURE=false
# SMTP_FROM (opcional; default: SMTP_USER)

# Base URL para enlaces en correos (reset-password, etc.)
# En producción: definir con tu dominio. En localhost: se usa el origin.
# APP_URL="https://tudominio.com/admin"

# En localhost: poner "true" para no enviar correos reales (solo loguea)
# EMAIL_SKIP_SEND=false
