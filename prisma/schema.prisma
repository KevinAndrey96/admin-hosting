// =============================================================================
// Prisma Schema - Admin Panel (Reseller domains/hosting)
// =============================================================================
// Docs: https://pris.ly/d/prisma-schema
// Fresh migrate: npm run db:reset
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// -----------------------------------------------------------------------------
// Auth & Users
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CLIENT
}

enum UserStatus {
  ENABLED
  DISABLED
}

model User {
  id          String     @id @default(cuid())
  fullName    String     @map("full_name")
  email       String     @unique
  phone       String?
  companyName String?    @map("company_name")
  address     String?
  zipCode     String?    @map("zip_code")
  password    String
  role        UserRole   @default(CLIENT)
  status      UserStatus @default(ENABLED)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]
  domains            Domain[]
  hosting             HostingService[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userID    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// -----------------------------------------------------------------------------
// Reseller - Packages, Domains, Hosting
// -----------------------------------------------------------------------------

model HostingPackage {
  id                 String   @id @default(cuid())
  name               String   @map("name")
  colorHex           String?  @map("color_hex") @db.VarChar(7)
  salePrice          Decimal  @map("sale_price") @db.Decimal(10, 2)
  currency           String   @default("COP")
  diskSpaceQuotaMb   Int?     @map("disk_space_quota_mb")     // null = unlimited
  bandwidthLimitMb   Int?     @map("bandwidth_limit_mb")     // null = unlimited
  maxEmailAccounts   Int?     @map("max_email_accounts")     // null = unlimited
  maxParkedDomains   Int?     @map("max_parked_domains")
  maxAddonDomains    Int?     @map("max_addon_domains")      // null = unlimited
  includedDomains    Int      @map("included_domains")       // domains included in plan
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  hosting HostingService[]

  @@map("hosting_packages")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum HostingServiceStatus {
  ENABLED
  SUSPENDED
  CANCELLED
}

enum HealthStatus {
  UP
  DOWN
  UNKNOWN
}

enum BillingCycle {
  ANNUAL
}

model Domain {
  id             String              @id @default(cuid())
  userID         String              @map("user_id")
  registrarName  String              @map("registrar_name")
  fqdn           String              // e.g. example.com
  salePrice      Decimal              @map("sale_price") @db.Decimal(10, 2)
  currency       String              @default("COP")
  billingCycle   BillingCycle        @default(ANNUAL) @map("billing_cycle")
  renewalDate    DateTime            @map("renewal_date")
  nextBillingDate DateTime           @map("next_billing_date")
  paymentStatus  PaymentStatus       @default(PENDING) @map("payment_status")
  transferLock   Boolean             @default(true) @map("transfer_lock")
  healthStatus   HealthStatus        @default(UNKNOWN) @map("health_status")
  nameserver1    String?             @map("nameserver_1")
  nameserver2    String?             @map("nameserver_2")
  registrantName  String?            @map("registrant_name")
  registrantOrg   String?            @map("registrant_org")
  registrantEmail String?            @map("registrant_email")
  registrantPhone String?            @map("registrant_phone")
  registrantAddress String?          @map("registrant_address") @db.Text
  registrantCity  String?            @map("registrant_city")
  registrantState String?            @map("registrant_state")
  registrantCountry String?          @map("registrant_country")
  registrantPostalCode String?       @map("registrant_postal_code")
  privacyEnabled  Boolean           @default(false) @map("privacy_enabled")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  user        User              @relation(fields: [userID], references: [id], onDelete: Cascade)
  hostingDomains HostingDomain[]

  @@index([userID])
  @@index([nextBillingDate, paymentStatus])
  @@map("domains")
}

model HostingService {
  id             String              @id @default(cuid())
  userID         String              @map("user_id")
  packageID      String              @map("package_id")
  username       String
  billingCycle   BillingCycle        @default(ANNUAL) @map("billing_cycle")
  nextBillingDate DateTime           @map("next_billing_date")
  paymentStatus  PaymentStatus       @default(PENDING) @map("payment_status")
  serviceStatus  HostingServiceStatus @default(ENABLED) @map("service_status")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  user    User            @relation(fields: [userID], references: [id], onDelete: Cascade)
  hostingPackage HostingPackage @relation(fields: [packageID], references: [id], onDelete: Restrict)
  domains HostingDomain[]

  @@index([userID])
  @@index([packageID])
  @@index([nextBillingDate, paymentStatus])
  @@map("hosting_services")
}

model HostingDomain {
  id         String         @id @default(cuid())
  hostingID  String         @map("hosting_id")
  domainID   String         @map("domain_id")

  hosting HostingService @relation(fields: [hostingID], references: [id], onDelete: Cascade)
  domain Domain         @relation(fields: [domainID], references: [id], onDelete: Cascade)

  @@unique([hostingID, domainID])
  @@index([hostingID])
  @@index([domainID])
  @@map("hosting_domains")
}
