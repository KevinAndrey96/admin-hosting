# Database - Prisma (required)
# SQLite (local development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/admin?schema=public"

# For MySQL:
# DATABASE_URL="mysql://user:password@localhost:3306/admin"

# Session secret (min 32 chars) - generate with: openssl rand -base64 32
SESSION_SECRET="your-session-secret-at-least-32-characters-long"

# Google Maps API Key (optional - for maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=tu-api-key
